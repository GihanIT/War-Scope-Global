{
  "installCommand": "npm install --prefix backend && PUPPETEER_SKIP_DOWNLOAD=true npm install --prefix frontend",
  "buildCommand": "cd frontend && npx vite build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}