{
  "name": "warscope-frontend",
  "version": "1.0.0",
  "description": "WarScope frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-globe.gl": "^2.27.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "crawl": true,
    "include": [
      "/",
      "/blog",
      "/compare",
      "/nuclear",
      "/sanctions",
      "/timeline",
      "/incidents",
      "/vehicles",
      "/units",
      "/arms-trade",
      "/about",
      "/contact",
      "/data-sources",
      "/methodology",
      "/privacy-policy",
      "/terms",
      "/disclaimer",
      "/cookie-policy"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": true,
    "headless": true
  }
}
