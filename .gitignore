# ============================================
# WarScope — .gitignore
# ============================================
# Place this file in war-globe-platform/ root


# ============================================
# ENVIRONMENT VARIABLES (never commit these)
# ============================================
.env
.env.local
.env.development
.env.production
.env.staging
backend/.env
frontend/.env
frontend/.env.local


# ============================================
# NODE MODULES
# ============================================
node_modules/
backend/node_modules/
frontend/node_modules/


# ============================================
# FRONTEND BUILD OUTPUT
# ============================================
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/build/


# ============================================
# DATA FILES (too large for git)
# ============================================
data/raw/*.csv
data/processed/
# Keep conflicts.json in git (manually maintained)
!data/conflicts.json


# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
scripts/__pycache__/
venv/
env/
.venv/
*.egg-info/
dist/
build/


# ============================================
# LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/


# ============================================
# OS FILES
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encdata
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ============================================
# EDITOR & IDE
# ============================================

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (WebStorm, PyCharm)
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
Session.vim

# Sublime Text
*.sublime-project
*.sublime-workspace


# ============================================
# DOCKER
# ============================================
docker/.env
docker/data/


# ============================================
# PM2 (production process manager)
# ============================================
.pm2/
ecosystem.config.local.js


# ============================================
# TESTING
# ============================================
coverage/
.nyc_output/
*.test.js.snap


# ============================================
# MISC
# ============================================
*.zip
*.tar.gz
*.rar
.cache/
.temp/
tmp/